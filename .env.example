# Copy to .env.local and fill in. NEVER commit the real file.
# All three connection strings use the Supabase *Session pooler* (port 5432 on
# aws-0-<region>.pooler.supabase.com) with sslmode=require.

# --- Supabase Auth (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# --- Admin connection: used ONLY by `npm run db:setup` and CI checks ---
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Least-privilege roles created by `npm run db:setup` ---
QUIZ_APP_PASSWORD=<choose-a-strong-password>
QUIZ_TAKER_PASSWORD=<choose-another-strong-password>

# App writer role (saves submissions, appends to the audit log)
APP_DATABASE_URL=postgresql://quiz_app.<project-ref>:<QUIZ_APP_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Read-only role that executes student SQL
TAKER_DATABASE_URL=postgresql://quiz_taker.<project-ref>:<QUIZ_TAKER_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
